rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada alumno solo puede leer y escribir su propio progreso (users/{su uid}).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Turno del día: cualquiera con cuenta ve el ranking; cada uno carga SU puntaje una sola vez
    // (sin modificar ni borrar: vale el primer intento).
    match /daily/{day}/scores/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'score', 'ok', 'total', 'secs', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.score is int && request.resource.data.score <= 5000
        && request.resource.data.ok is int && request.resource.data.total is int
        && request.resource.data.ok <= request.resource.data.total
        && request.resource.data.secs is int;
    }
  }
}
